{
  "name": "eokahya-site",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Personal academic website of Prof. Dr. Emre Onur Kahya — static Astro site for GitHub Pages.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "typecheck": "astro check && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build:html": "astro build",
    "pdf": "node --import tsx scripts/generate-pdf.ts",
    "build": "npm run build:html && npm run pdf && npm run check:links && npm run check:i18n",
    "check:links": "node scripts/check-links.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:pdf": "node --import tsx scripts/check-pdf.ts",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:browser": "node scripts/browser-check.mjs",
    "check:lighthouse": "node scripts/lighthouse-check.mjs",
    "serve": "node scripts/static-server.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "images": "node scripts/make-images.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@types/node": "^26.6.4",
    "lighthouse": "^13.5.0",
    "pdfjs-dist": "^6.3.289",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
