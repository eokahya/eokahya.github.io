---
import Base from '../layouts/Base.astro';
import Plate from '../components/Plate.astro';
import PublicationItem from '../components/PublicationItem.astro';
import Icon from '../components/Icon.astro';
import { researchAreas } from '../data/research';
import { publications } from '../data/publications';
import { profile } from '../data/profile';
import { course } from '../data/course';
import { href, type Lang } from '../i18n';
import { pagesCopy } from '../i18n/copy/pages';
import '../styles/pages.css';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = pagesCopy[lang].research;
const evidence = (ids: string[]) => ids.map((id) => publications.find((p) => p.id === id)!).filter(Boolean);
const countByTopic = (id: string) => publications.filter((p) => (p.topics as string[]).includes(id)).length;
const projectsFor = (titles: string[]) => titles.map((title) => profile.projects.find((p) => p.title === title)!).filter(Boolean);
---
<Base lang={lang} title={c.metaTitle} description={c.description}>
  <div class="page">
    <header class="page-hero" style="--hero-tint: var(--blue)">
      <div class="page-hero__inner">
        <div class="page-hero__text">
          <p class="kicker">{c.kicker}</p>
          <h1>{c.title[0]}<em>{c.title[1]}</em></h1>
          <p class="lead">{c.lead}</p>
        </div>
        <div class="page-hero__art" aria-hidden="true"><Plate name="spacetime" eager /></div>
      </div>
      <nav class="wrap" aria-label={c.indexLabel}>
        <ol class="research-index" role="list">
          {researchAreas.map((area) => (
            <li><a href={`#${area.id}`}><span class="research-index__letter">{area.numeral}</span><span class="research-index__title">{area[lang].title}</span><span class="badge">{area.current ? c.current : c.records(countByTopic(area.id))}</span></a></li>
          ))}
        </ol>
      </nav>
    </header>

    {researchAreas.map((area) => (
      <section class="area" id={area.id} aria-labelledby={`${area.id}-title`}>
        <div class="area__grid">
          <div class="area__art" aria-hidden="true"><Plate name={area.plate} caption={c.captions[area.plate]} /></div>
          <div class="area__body" data-reveal>
            <div class="area__head">
              <span class="area__letter" aria-hidden="true">{area.numeral}</span>
              <span class:list={['badge', { 'badge--accent': area.current }]}>{area[lang].status}</span>
            </div>
            <h2 id={`${area.id}-title`}>{area[lang].title}</h2>
            {area[lang].description.map((paragraph) => <p>{paragraph}</p>)}
            <ul class="chips area__keywords" aria-label={c.keywords}>{area[lang].keywords.map((keyword) => <li>{keyword}</li>)}</ul>
            {area.projects.length > 0 && (
              <div class="area__projects">
                <h3>{c.projects}</h3>
                <ul role="list">
                  {projectsFor(area.projects).map((project) => (
                    <li><span class="area__project-title">{lang === 'tr' ? project.titleTr : project.title}</span><span class="area__project-meta">{lang === 'tr' ? project.funderTr : project.funder}{project.number && ` · ${project.number}`} · {project.period} · {c.role[project.role]}</span></li>
                  ))}
                </ul>
              </div>
            )}
            {area.evidence.length > 0 ? (
              <div class="area__evidence">
                <h3>{c.representative}</h3>
                {evidence(area.evidence).map((p) => <PublicationItem publication={p} compact headingLevel="h4" lang={lang} />)}
                <p class="act__links"><a class="text-link" href={`${href(lang, 'publications')}?topic=${area.id}`}>{c.allInArea(countByTopic(area.id))} <Icon name="arrow-right" size={16} /></a></p>
              </div>
            ) : (
              <div class="area__direction note">
                {c.directionNote[0]}{course.code}{c.directionNote[1]}<a href={`${course.path}#project-guide`} hreflang="en">{c.directionNote[2]}</a>.
              </div>
            )}
          </div>
        </div>
      </section>
    ))}

    <section class="connections" aria-labelledby="connections-title">
      <div>
        <p class="kicker">{c.connectionsKicker}</p>
        <h2 id="connections-title">{c.connectionsTitle[0]}<em>{c.connectionsTitle[1]}</em></h2>
      </div>
      <div class="prose" data-reveal>
        {c.connections.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>
  </div>
</Base>
