---
/**
 * Projects: five open research projects as a scroll-driven "research atlas", the sibling of the
 * home-page journey. The particle scene is decoration (aria-hidden); every question, result and
 * repository link is plain HTML and readable without JavaScript, WebGL or motion.
 */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import QuantumGravityPlate from '../components/project-plates/QuantumGravityPlate.astro';
import ConformalScalarPlate from '../components/project-plates/ConformalScalarPlate.astro';
import MoeRotationPlate from '../components/project-plates/MoeRotationPlate.astro';
import SplitEnrichPlate from '../components/project-plates/SplitEnrichPlate.astro';
import Gpt2SpectralPlate from '../components/project-plates/Gpt2SpectralPlate.astro';
import { projects } from '../data/projects';
import { type Lang } from '../i18n';
import { pagesCopy } from '../i18n/copy/pages';
import '../styles/home.css';
import '../styles/projects.css';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = pagesCopy[lang].projects;
const plates = [QuantumGravityPlate, ConformalScalarPlate, MoeRotationPlate, SplitEnrichPlate, Gpt2SpectralPlate];
const atlasStrings = {
  labels: [['I–V', c.indexLabel], ...projects.map((p) => [p.numeral, p[lang].short])],
  pause: c.pause,
  resume: c.resume,
};
const details = lang === 'tr' ? 'Ayrıntılar ve sayılar' : 'Details and numbers';
---
<Base lang={lang} title={c.metaTitle} description={c.description} bodyClass="is-projects">
  <div class="journey atlas" data-atlas data-stage="0" data-i18n={JSON.stringify(atlasStrings)}>
    <div class="journey-stage">
      <div class="atlas-glow" aria-hidden="true"></div>
      <canvas id="atlas-canvas" aria-hidden="true"></canvas>
      <div class="journey-shade" aria-hidden="true"></div>
    </div>
    <section class="act act--hero atlas-hero" id="projects-top" data-atlas-act data-side="left" aria-labelledby="projects-title">
      <div class="act__content act__content--left atlas-hero__content">
        <p class="kicker">{c.kicker}</p>
        <h1 id="projects-title" class="atlas-title">{c.title[0]}<em>{c.title[1]}</em></h1>
        <p class="lead atlas-lead">{c.lead}</p>
        <nav aria-label={c.indexLabel}>
          <ol class="atlas-index" role="list">
            {projects.map((p) => (
              <li style={`--project: var(--${p.tint})`}>
                <a href={`#${p.id}`}>
                  <span class="atlas-index__numeral">{p.numeral}</span>
                  <span class="atlas-index__text">
                    <span class="atlas-index__title">{p[lang].title}</span>
                    <span class="atlas-index__meta">{p[lang].kind.split(' · ')[0]} · {p[lang].verdictPlain}</span>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
        <p class="atlas-method">{c.method}</p>
      </div>
    </section>

    {projects.map((p, i) => {
      const t = p[lang];
      const Plate = plates[i]!;
      const side = i % 2 === 0 ? 'right' : 'left';
      return (
        <section class:list={['act', `act--${side}`, 'project']} id={p.id} data-atlas-act data-side={side} style={`--project: var(--${p.tint})`} aria-labelledby={`${p.id}-title`}>
          <div class="atlas-plate" aria-hidden="true"><Plate /></div>
          <div class="act__content project__content" data-reveal>
            <p class="kicker"><span class="numeral">{p.numeral}</span><span>{t.kind} · {p.year}</span></p>
            <h2 id={`${p.id}-title`}>{t.title}</h2>
            <p class="project__question"><span class="project__label">{c.question}</span>{t.question}</p>
            <div class="project__scene">
              <button class="chip-button project__toggle" type="button" hidden data-atlas-focus={i + 1} aria-pressed="false" aria-describedby={`${p.id}-caption`} data-caption-on={t.captionOn} data-caption-off={t.captionOff}>{t.focusLabel}</button>
              <p class="project__caption" id={`${p.id}-caption`} aria-live="polite">{t.captionOff}</p>
            </div>
            <p class="project__summary">{t.summary}</p>
            <div class="project__result">
              <p class="project__label">{c.result}</p>
              <p class="project__verdict">{p.verdict && <code lang="en">{p.verdict}</code>}<span>{t.verdictPlain}</span></p>
              <p>{t.result}</p>
            </div>
            <details class="project__details">
              <summary>{details}</summary>
              {t.detail && <p>{t.detail}</p>}
              <dl class="project__facts">
                {t.facts.map((fact) => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}
              </dl>
            </details>
            <div class="project__actions">
              <a class="button project__repo" href={p.repo}>{c.repo} <Icon name="external" size={16} /></a>
            </div>
          </div>
        </section>
      );
    })}
    <div class="journey-overlay">
      <div class="journey-hud">
        <p class="plate-label" aria-hidden="true">
          <span class="plate-label__tag">{c.plate} <span data-plate-number>I–V</span></span>
          <span class="plate-label__name" data-plate-name>{c.indexLabel}</span>
          <span class="plate-label__caption">{c.schematic}</span>
        </p>
        <button class="hud-button" id="atlas-motion" type="button" data-paused="false" hidden>
          <span class="hud-button__pause"><Icon name="pause" size={16} /></span>
          <span class="hud-button__play"><Icon name="resume" size={16} /></span>
          <span data-label>{c.pause}</span>
        </button>
      </div>
      <nav class="journey-rail" aria-label={c.railLabel}>
        <ol>
          <li><a href="#projects-top" data-rail-link aria-current="step"><span class="rail__numeral" aria-hidden="true">·</span> <span class="rail__name">{c.indexLabel}</span></a></li>
          {projects.map((p) => (
            <li><a href={`#${p.id}`} data-rail-link><span class="rail__numeral">{p.numeral}</span> <span class="rail__name">{p[lang].short}</span></a></li>
          ))}
        </ol>
      </nav>
    </div>

  </div>

  <section class="home-section atlas-outro" aria-labelledby="outro-title">
    <div class="wrap atlas-outro__inner">
      <p class="kicker">{c.outroKicker}</p>
      <h2 id="outro-title">{c.outroTitle[0]}<em>{c.outroTitle[1]}</em></h2>
      <p class="lead">{c.outroText}</p>
      <p class="act__links"><a class="text-link" href="https://github.com/eokahya">{c.allRepos} <Icon name="external" size={16} /></a></p>
    </div>
  </section>
</Base>

<script>
  import '../scripts/atlas/index';
</script>
