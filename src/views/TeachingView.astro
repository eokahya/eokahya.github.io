---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import AssessmentBar from '../components/AssessmentBar.astro';
import WeekStrip from '../components/WeekStrip.astro';
import Plate from '../components/Plate.astro';
import { course } from '../data/course';
import { numberWord } from '../lib/format';
import type { Lang } from '../i18n';
import { pagesCopy } from '../i18n/copy/pages';
import '../styles/pages.css';
import '../styles/course.css';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = pagesCopy[lang].teaching;
const foundations = course.weeks.filter((week) => week.phase === 'foundations').length;
---
<Base lang={lang} title={c.metaTitle} description={c.description}>
  <div class="page">
    <header class="page-hero" style="--hero-tint: var(--cyan)">
      <div class="page-hero__inner">
        <div class="page-hero__text">
          <p class="kicker">{c.kicker}</p>
          <h1>{c.title[0]}<em>{c.title[1]}</em></h1>
          <p class="lead">{c.lead}</p>
        </div>
        <div class="page-hero__art" aria-hidden="true"><Plate name="manifold" eager /></div>
      </div>
    </header>
    <section class="teaching-card" aria-labelledby="course-title">
      <div class="teaching-card__main">
        <p class="kicker kicker--plain">{course.code} · {c.meta(course.term, course.language)}</p>
        <h2 id="course-title" lang={lang === 'tr' ? 'en' : undefined}>{course.title}</h2>
        <p class="muted">{c.summary(numberWord(foundations, lang))}</p>
        {c.languageNote && <p class="note" style="margin-top:1.2rem">{c.languageNote}</p>}
        <div class="action-row">
          <a class="button" href={course.path} hreflang="en">{c.coursePage} <Icon name="arrow-right" size={18} class="icon--nudge" /></a>
          <a class="button button--ghost" href={course.syllabusPath} hreflang="en" download><Icon name="download" size={18} />{c.syllabus}</a>
          <a class="text-link" href={`${course.path}#lecture-notes`} hreflang="en">{c.notes} <Icon name="arrow-right" size={16} /></a>
        </div>
        <p class="muted small" style="margin-top:1.6rem"><span lang="en">{course.timetable}</span> {c.permanent} <a href={course.termPath} hreflang="en">{course.termPath}</a></p>
      </div>
      <div class="teaching-card__aside">
        <div><h3 class="panel-title">{c.assessment}</h3><AssessmentBar lang={lang} /></div>
        <div><h3 class="panel-title">{c.weeks}</h3><WeekStrip lang={lang} /></div>
      </div>
    </section>
  </div>
</Base>
