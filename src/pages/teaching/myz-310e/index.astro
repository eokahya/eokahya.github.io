---
import Layout from '../../../layouts/Layout.astro';
import CourseContent from '../../../components/CourseContent.astro';
import {course} from '../../../data/course';
import {scanLectureNotes} from '../../../../scripts/scan-notes';
const notes=await scanLectureNotes();
---
<Layout title={`${course.code} — ${course.title}`} description="MYZ 310E, Fall 2026: foundations of machine learning and a mechanistic interpretability project. Syllabus, assessment and weekly PDF notes." canonical={course.termPath}><div class="wrap page-shell"><CourseContent notes={notes}/></div></Layout>
