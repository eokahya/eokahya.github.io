---
import Icon from './Icon.astro';
import { formatDuration, formatMonth, formatViews, watchUrl, type Video } from '../data/outreach';
import type { Lang } from '../i18n';
import { ui } from '../i18n/ui';

interface Props { video: Video; variant?: 'banner' | 'feature' | 'row' | 'clip'; programme?: string; headingLevel?: 'h3' | 'h4'; lang?: Lang }
const { video, variant = 'row', programme = 'Teke Tek Bilim', headingLevel = 'h3', lang = 'en' } = Astro.props;
const u = ui[lang];
const Heading = headingLevel;
const url = watchUrl(video);
const date = video.aired ?? video.published;
const themeGlyph: Record<string, string> = { ai: 'circuit', cosmos: 'orbit', history: 'hourglass', quantum: 'wave', nobel: 'medal', thinking: 'spark', sinanoglu: 'atom', academia: 'building' };
const glyph = video.glyph ?? (video.theme ? themeGlyph[video.theme] ?? 'orbit' : 'wave');
---
<article class:list={['video', `video--${variant}`, `video--${video.theme ?? 'lesson'}`]}>
  {variant !== 'row' && (
    <div class="video__art" aria-hidden="true" data-glyph={glyph}>
      <svg viewBox="0 0 120 80" preserveAspectRatio="xMidYMid slice">
        {glyph === 'circuit' && <g fill="none" stroke="currentColor" stroke-width="1.1"><circle cx="22" cy="24" r="4"/><circle cx="22" cy="56" r="4"/><circle cx="60" cy="40" r="5"/><circle cx="98" cy="40" r="4"/><path d="M26 25.5 55.5 38M26 54.5 55.5 42M65 40h29" /><path d="M26 25.5 55.5 38M65 40h29" stroke-width="2.2" stroke="var(--accent)"/></g>}
        {glyph === 'orbit' && <g fill="none" stroke="currentColor" stroke-width="1.1"><ellipse cx="60" cy="40" rx="44" ry="15" transform="rotate(-18 60 40)"/><ellipse cx="60" cy="40" rx="26" ry="9" transform="rotate(-18 60 40)" opacity="0.6"/><circle cx="60" cy="40" r="6" fill="var(--accent)" stroke="none"/><circle cx="100" cy="27" r="2.6" fill="currentColor"/></g>}
        {glyph === 'wave' && <g fill="none" stroke="currentColor" stroke-width="1.2"><path d="M6 40c9-18 18-18 27 0s18 18 27 0 18-18 27 0 18 18 27 0" /><path d="M6 40c9-10 18-10 27 0s18 10 27 0 18-10 27 0 18 10 27 0" opacity="0.5" stroke="var(--accent)"/></g>}
        {glyph === 'hourglass' && <g fill="none" stroke="currentColor" stroke-width="1.1"><path d="M44 12h32M44 68h32M48 12c0 18 24 18 24 28S48 50 48 68M72 12c0 18-24 18-24 28s24 10 24 28"/><path d="M53 62c2-6 12-6 14 0z" fill="var(--accent)" stroke="none"/><circle cx="60" cy="44" r="1.6" fill="var(--accent)" stroke="none"/></g>}
        {glyph === 'atom' && <g fill="none" stroke="currentColor" stroke-width="1.1"><ellipse cx="60" cy="40" rx="34" ry="11"/><ellipse cx="60" cy="40" rx="34" ry="11" transform="rotate(60 60 40)"/><ellipse cx="60" cy="40" rx="34" ry="11" transform="rotate(120 60 40)"/><circle cx="60" cy="40" r="4.5" fill="var(--accent)" stroke="none"/></g>}
        {glyph === 'sun' && <g fill="none" stroke="currentColor" stroke-width="1.1"><circle cx="60" cy="40" r="13" fill="var(--accent)" stroke="none" opacity="0.9"/><path d="M60 14v-6M60 72v-6M34 40h-6M92 40h-6M42 22l-4-4M82 62l-4-4M42 58l-4 4M82 18l-4 4"/><path d="M73 33c10-6 20-4 26 2" stroke="var(--coral)" stroke-width="1.6"/></g>}
        {glyph === 'halo' && <g fill="none" stroke="currentColor" stroke-width="1.1"><circle cx="60" cy="40" r="32" stroke-dasharray="2 4" opacity="0.7"/><ellipse cx="60" cy="40" rx="20" ry="6" transform="rotate(-20 60 40)"/><circle cx="60" cy="40" r="3.5" fill="var(--accent)" stroke="none"/></g>}
        {glyph === 'bubbles' && <g fill="none" stroke="currentColor" stroke-width="1.1"><circle cx="48" cy="42" r="20"/><circle cx="74" cy="34" r="14" stroke="var(--accent)" stroke-width="1.6"/><circle cx="82" cy="58" r="8"/><circle cx="30" cy="22" r="6"/></g>}
        {glyph === 'expansion' && <g fill="currentColor" stroke="none"><circle cx="60" cy="40" r="3" fill="var(--accent)"/>{[0, 1, 2, 3, 4, 5, 6, 7].map((k) => { const a = (k / 8) * Math.PI * 2; return <Fragment><circle cx={60 + Math.cos(a) * 16} cy={40 + Math.sin(a) * 11} r="1.6" opacity="0.8" /><circle cx={60 + Math.cos(a) * 34} cy={40 + Math.sin(a) * 23} r="1.6" opacity="0.55" /><circle cx={60 + Math.cos(a) * 52} cy={40 + Math.sin(a) * 35} r="1.6" opacity="0.3" /></Fragment>; })}</g>}
        {glyph === 'ladder' && <g fill="none" stroke="currentColor" stroke-width="1.1"><path d="M22 66h20V54h20V42h20V30h16"/><circle cx="32" cy="60" r="2" fill="currentColor"/><circle cx="52" cy="48" r="2.4" fill="currentColor"/><circle cx="72" cy="36" r="2.8" fill="currentColor"/><circle cx="92" cy="22" r="3.4" fill="var(--accent)" stroke="none"/></g>}
        {glyph === 'curve' && <g fill="none" stroke="currentColor" stroke-width="1"><path d="M10 22h100M10 34c30 0 34 10 50 10s20-10 50-10M10 46c30 0 34 14 50 14s20-14 50-14M10 58h100" opacity="0.7"/><circle cx="60" cy="50" r="6" fill="var(--accent)" stroke="none"/></g>}
        {glyph === 'medal' && <g fill="none" stroke="currentColor" stroke-width="1.1"><circle cx="60" cy="46" r="18"/><circle cx="60" cy="46" r="11" stroke="var(--accent)" stroke-width="1.8"/><path d="M48 12l8 18M72 12l-8 18"/></g>}
        {glyph === 'spark' && <g fill="none" stroke="currentColor" stroke-width="1.1"><path d="M60 12v56M32 40h56M40 20l40 40M80 20 40 60" opacity="0.5"/><circle cx="60" cy="40" r="8" stroke="var(--accent)" stroke-width="1.8"/></g>}
        {glyph === 'building' && <g fill="none" stroke="currentColor" stroke-width="1.1"><path d="M24 64h72M30 64V34l30-18 30 18v30M44 64V44h32v20"/><path d="M60 16v-6" stroke="var(--accent)" stroke-width="1.8"/></g>}
      </svg>
    </div>
  )}
  <div class="video__body">
    {variant !== 'row' && <p class="video__programme">{programme}{video.format === 'short' && ` · ${u.clip}`}</p>}
    <Heading class="video__title"><a href={url} lang={video.lang} target="_blank" rel="noopener">{video.title}<span class="visually-hidden" lang={lang}> — {u.watchOnYouTube}</span></a></Heading>
    {video.with && variant !== 'row' && <p class="video__with">{u.with} {video.with.join(', ')}</p>}
    {variant === 'row' ? (
      <p class="video__meta"><span>{formatViews(video.views, lang)} {u.views}</span><span>{formatDuration(video.durationSeconds, lang)}</span><span><time datetime={date}>{formatMonth(date, lang)}</time>{video.aired && <span class="video__aired"> ({u.aired})</span>}</span></p>
    ) : (
      <p class="video__meta">
        <span><Icon name="eye" size={14} />{formatViews(video.views, lang)} {u.views}</span>
        {video.format !== 'short' && <span><Icon name="clock" size={14} />{formatDuration(video.durationSeconds, lang)}</span>}
        <span><Icon name="calendar" size={14} /><time datetime={date}>{formatMonth(date, lang)}</time>{video.aired && <span class="video__aired"> ({u.aired})</span>}</span>
      </p>
    )}
  </div>
  {variant !== 'row' && <span class="video__go" aria-hidden="true"><Icon name="external" size={18} /></span>}
</article>
