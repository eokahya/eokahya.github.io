---
/** Brand glyph: a body with an inclined orbit — two masses, one ellipse. */
interface Props { size?: number }
const { size = 30 } = Astro.props;
---
<svg class="brand-mark" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <ellipse cx="16" cy="16" rx="13.2" ry="5.4" transform="rotate(-28 16 16)" fill="none" stroke="currentColor" stroke-width="1.3" opacity="0.7" />
  <circle cx="16" cy="16" r="4.4" fill="var(--accent)" />
  <circle cx="26.6" cy="10.6" r="2" fill="currentColor" />
</svg>
